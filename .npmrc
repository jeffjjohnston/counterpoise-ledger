# Make the allowScripts map in package.json enforcing rather than advisory.
#
# Without this, npm 11 runs an unapproved dependency's install script and only
# prints a warning afterwards -- the allowlist documents intent but blocks
# nothing. With it, an install script that is not in allowScripts is skipped,
# so a new or compromised transitive dependency cannot execute code at install
# time until it is explicitly approved via `npm install-scripts approve`.
strict-allow-scripts=true
