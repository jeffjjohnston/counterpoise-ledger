# Copy to .env.local for development, or .env.production.local for the Docker
# deployment's own checkout on the main branch.
#
# RULE: secrets in .env.local must NOT match .env.production.local.
# Dev values get pasted into docs, issue reports, and terminals far more
# casually than production ones. Keeping them distinct means such a paste
# discloses nothing that protects production.

# The SQLite database file. Development needs no setting: the server and
# ledger-cli use data/counterpoise.db in the checkout, and the server creates it
# on its first start. The production image sets /data/counterpoise.db, in the
# counterpoise_data volume. Do not set it in .env.production.local.
# DATABASE_PATH=data/counterpoise.db

# There is no DATABASE_URL any more. An install that still has one, and has no
# database file yet, has not converted its PostgreSQL data: the server refuses
# to start and names guides/upgrade-to-sqlite.md.

# Optional. The server runs the scheduled jobs itself; this bearer token only
# gates the manual triggers under /api/cron/*. Without it those routes refuse.
# Generate with: openssl rand -hex 32
# Use a DIFFERENT value in dev than in production.
CRON_SECRET=

# Plaid bank sync. See "Connecting a Bank (Plaid)" in the README for how to get
# these, and `npm run plaid:link` for minting an access token.
# Dev must use SANDBOX credentials — production credentials in .env.local mean
# `npm run dev` reaches real banks and bills real API requests, and the separate
# dev database file does nothing to prevent it (it bounds writes, not
# outbound calls).
# Leaving client id/secret blank makes isPlaidConfigured() false, so sync fails
# closed rather than reaching a live institution.
# PLAID_ENV takes sandbox or production only; Plaid retired the development
# environment, so that value now resolves to a host that no longer answers.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Optional TypeSafe experiment. Both server configuration AND a book's Settings
# opt-in are required. Restart the app after changing this installation-wide switch.
# Keep the key server-side; use a separate key for development. Never NEXT_PUBLIC_.
TYPESAFE_ENABLED=false
TYPESAFE_API_KEY=

# Tiingo end-of-day security prices. Read-only market data with no sandbox tier,
# so sharing one key across dev and prod is acceptable; the only cost is dev
# consuming the production rate limit.
TIINGO_API_KEY=

# PostHog telemetry — configure in .env.production.local only.
# Omit from .env / .env.local so dev and test never send events.
# The two NEXT_PUBLIC_ values go into the client at BUILD TIME (vite.config.ts
# reads them; docker-compose.yml passes them as build args of rust-api), so a
# change needs a rebuild — ./scripts/deploy.sh rebuilds. The Rust server also
# reads them at runtime for server-side events.
# NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_api_key
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# POSTHOG_PERSONAL_API_KEY=phx_your_personal_api_key

# Timezone for the rust-api container. SET THIS to your own zone — it controls
# when the scheduled jobs run and, via cp_today(), the effective date of
# floating transactions. Leaving it unset falls back to America/New_York.
#
# This is read by Compose *interpolation*, which only sees the shell, a .env
# file, or --env-file. Run compose as
# `docker compose --env-file .env.production.local up -d` or it is ignored.
TZ=America/New_York

# Where the rust-api container publishes host port 3000. Defaults to loopback
# so that a reverse proxy is the only ingress; set 0.0.0.0 to expose it on your LAN.
# Read by Compose interpolation, so pass --env-file (see README).
# Compose also gives this value to the server, which uses it to choose the
# client address for the rate limits (see TRUST_PROXY below).
APP_BIND=127.0.0.1

# Whether the rate limits take the client address from X-Forwarded-For.
# Unset: yes when APP_BIND is loopback (then a reverse proxy on this host is
# the only way in), no in all other cases. With no, the server uses the TCP
# peer address and ignores the header, because a client that connects directly
# can write any value in it. The same decision applies to X-Forwarded-Host and
# X-Forwarded-Proto: with no, the server ignores them too.
#   true  — every request comes through a proxy that sets or appends
#           X-Forwarded-For, but the port is not on loopback (for example,
#           a proxy on a different host)
#   false — never use the header
# Any other value stops the server at start. See README, "Client addresses
# and rate limits".
# TRUST_PROXY=true

# OAuth for MCP custom connectors (claude.ai, Claude Desktop, Claude Code).
# The public origin of the server: scheme and host, with no path. Set it to
# turn OAuth on for /api/mcp; leave it unset to accept API keys only. The
# server cannot find its own public URL behind a proxy that terminates TLS,
# so it does not guess. Use https: http is accepted for localhost only. An
# invalid value stops the server at start. The hosted Claude apps call the
# server from Anthropic's cloud, so they need an address on public HTTPS.
# See guides/mcp-server.md, "OAuth for custom connectors".
# COUNTERPOISE_PUBLIC_URL=https://books.example.com

# Registration control. Unset means open only while no user exists, so a fresh
# install can create its first account and then closes itself.
#   true  — always open (set this temporarily to add a household member)
#   false — always closed
# REGISTRATION_ENABLED=true

# Send Strict-Transport-Security. Set this ONLY once HTTPS is confirmed
# working: it tells browsers to refuse plain HTTP to this host for a year,
# which will lock you out of a LAN deployment served over HTTP.
#
# The Rust server reads this value when it starts. It is not a build
# argument. After a change, recreate the container (docker compose up -d
# --force-recreate rust-api); a plain restart does not read the file again.
# ENABLE_HSTS=true

# Deploy only. scripts/deploy.sh reads COUNTERPOISE_BUILD_DIR from the
# gitignored file .env.deploy.local at the root of the dev checkout, when the
# variable is not set in the environment. Put this one line in that file.
# A leading ~/ expands to HOME. The default is ~/counterpoise-production.
# COUNTERPOISE_BUILD_DIR=~/counterpoise-production
