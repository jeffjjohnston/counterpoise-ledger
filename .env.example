# Copy to .env.local for development, or .env.production.local for the Docker
# deployment.
#
# RULE: secrets in .env.local must NOT match .env.production.local.
# Dev values get pasted into docs, issue reports, and terminals far more
# casually than production ones. Keeping them distinct means such a paste is
# harmless. (A shared CRON_SECRET is how a production secret once ended up
# committed in a planning doc.)

# Local development connects to counterpoise_dev.
# For .env.production.local (the Docker deployment) change this to the compose
# service hostname — inside the app container, localhost is the container itself:
#   DATABASE_URL=postgresql://counterpoise:counterpoise@postgres:5432/counterpoise
DATABASE_URL=postgresql://counterpoise:counterpoise@localhost:5432/counterpoise_dev

# Bearer token for /api/cron/* endpoints. Read via env_file by both the app and
# scheduler services, which must therefore hold the same value as each other.
# Generate with: openssl rand -hex 32
# Use a DIFFERENT value in dev than in production.
CRON_SECRET=

# Plaid bank sync.
# Dev must use SANDBOX credentials — production credentials in .env.local mean
# `npm run dev` reaches real banks and bills real API requests, and the separate
# counterpoise_dev database does nothing to prevent it (it bounds writes, not
# outbound calls).
# Leaving client id/secret blank makes isPlaidConfigured() false, so sync fails
# closed rather than reaching a live institution.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Tiingo end-of-day security prices. Read-only market data with no sandbox tier,
# so sharing one key across dev and prod is acceptable; the only cost is dev
# consuming the production rate limit.
TIINGO_API_KEY=

# PostHog telemetry — configure in .env.production.local only.
# Omit from .env / .env.local so dev and test never send events.
# NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_api_key
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# POSTHOG_PERSONAL_API_KEY=phx_your_personal_api_key

# Timezone for the postgres, app, and scheduler containers. SET THIS to your own
# zone — it controls cron firing times and, via CURRENT_DATE, the effective date
# of floating transactions. Leaving it unset falls back to America/New_York.
#
# This and POSTGRES_PASSWORD below are read by Compose *interpolation*, which
# only sees the shell, a .env file, or --env-file. Run compose as
# `docker compose --env-file .env.production.local up -d` or these are ignored.
TZ=America/New_York

# Postgres password for the Docker deployment. Change this before altering the
# loopback-only port binding in docker-compose.yml. Keep it in sync with the
# password inside DATABASE_URL above.
POSTGRES_PASSWORD=counterpoise

# Where the app container publishes its port. Defaults to loopback so that a
# reverse proxy is the only ingress; set 0.0.0.0 to expose it on your LAN.
# Read by Compose interpolation, so pass --env-file (see README).
APP_BIND=127.0.0.1

# Registration control. Unset means open only while no user exists, so a fresh
# install can create its first account and then closes itself.
#   true  — always open (set this temporarily to add a household member)
#   false — always closed
# REGISTRATION_ENABLED=true

# Send Strict-Transport-Security. Set this ONLY once HTTPS is confirmed
# working: it tells browsers to refuse plain HTTP to this host for a year,
# which will lock you out of a LAN deployment served over HTTP.
#
# Consumed at IMAGE BUILD TIME (next.config.js's headers() is evaluated by
# `next build`, not at container start), so changing this value requires a
# rebuild — ./scripts/deploy.sh rebuilds — not just a container restart.
# ENABLE_HSTS=true
