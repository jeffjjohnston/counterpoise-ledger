# CI for a fork of Counterpoise.
#
# THIS FILE DOES NOT RUN. GitHub Actions reads only *.yml and *.yaml files in
# .github/workflows/, so the ".example" suffix keeps it inactive. To turn it on
# in your fork, remove the ".example" suffix from the file name.
#
# It is adapted from the upstream CI, which is not published. This version runs
# on GitHub's hosted runners. It checks lint, types, the OpenAPI contract, the
# Rust workspace, the production build (with no database), and the unit and
# integration tests. The tests use SQLite files, so no database service is
# needed. It does not run the end-to-end tests. To add them, install the
# Playwright browsers (`npx playwright install --with-deps`) and run
# `npm run test:e2e`.
name: CI

on:
  pull_request:
  push:
    branches: [main]
  workflow_dispatch:

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  rust-workspace:
    runs-on: ubuntu-latest
    timeout-minutes: 30

    steps:
      - uses: actions/checkout@v7

      - uses: dtolnay/rust-toolchain@1.99.1
        with:
          components: rustfmt, clippy
          targets: wasm32-unknown-unknown

      - name: Install WASM bindings generator
        run: cargo install wasm-bindgen-cli --version 0.2.129 --locked

      - name: Install WASM optimizer
        run: sudo apt-get update && sudo apt-get install -y binaryen

      - uses: actions/setup-node@v7
        with:
          node-version: 26
          cache: npm

      - run: npm ci

      - name: Check Rust formatting
        run: cargo fmt --all --check --manifest-path rust-api/Cargo.toml

      - name: Check Rust lint
        run: cargo clippy --workspace --all-targets --manifest-path rust-api/Cargo.toml -- -D warnings

      - name: Test Rust workspace
        run: cargo test --workspace --manifest-path rust-api/Cargo.toml

      - name: Build pure core for WebAssembly
        run: cargo build -p ledger-core --target wasm32-unknown-unknown --manifest-path rust-api/Cargo.toml

      # The server without its `native` feature is the code a Worker runs.
      - name: Check the server for WebAssembly without native
        run: cargo clippy -p counterpoise-rust-api --no-default-features --target wasm32-unknown-unknown --manifest-path rust-api/Cargo.toml -- -D warnings

      - name: Build Rust HTTP server and CLI for parity tests
        run: cargo build --locked -p counterpoise-rust-api -p ledger-cli --manifest-path rust-api/Cargo.toml

      # The committed openapi.json must match the code.
      - name: Check openapi.json is current
        run: npm run openapi:check

      - name: Build the browser WASM
        run: npm run core:wasm:build

      - name: Test rebuilt browser WASM in Node and DOM
        run: npx vitest run --project node --project dom tests/lib/wasm-client.test.ts tests/components/wasm-client.test.tsx

      - name: Run the HTTP suites against the Rust server
        run: npm run test:http

      - name: Run MCP tool suites over the Rust HTTP transport
        run: npm run test:mcp:http

      - name: Run the MCP stdio transport suites against the Rust server
        run: npm run test:mcp:stdio

  # Lint, types and the production build, in one job. The build runs with no
  # database service on purpose: a page that queries the database at build
  # time passes a build that has one, and fails `docker build`.
  static-checks:
    runs-on: ubuntu-latest
    timeout-minutes: 25

    steps:
      - uses: actions/checkout@v7

      - uses: actions/setup-node@v7
        with:
          node-version: 26
          cache: npm

      - uses: dtolnay/rust-toolchain@1.99.1
        with:
          targets: wasm32-unknown-unknown

      - name: Install WASM build tools
        run: |
          cargo install wasm-bindgen-cli --version 0.2.129 --locked
          sudo apt-get update && sudo apt-get install -y binaryen

      - run: npm ci

      - run: npm run core:wasm:build

      - name: Lint
        run: npm run lint

      - name: Type check
        run: npx tsc --noEmit

      - name: Build the client (no database)
        run: npm run build

  unit-tests:
    runs-on: ubuntu-latest
    timeout-minutes: 25

    steps:
      - uses: actions/checkout@v7

      - uses: actions/setup-node@v7
        with:
          node-version: 26
          cache: npm

      - uses: dtolnay/rust-toolchain@1.99.1
        with:
          targets: wasm32-unknown-unknown

      - name: Install WASM build tools
        run: |
          cargo install wasm-bindgen-cli --version 0.2.129 --locked
          sudo apt-get update && sudo apt-get install -y binaryen

      - run: npm ci

      # Each Vitest worker makes its SQLite file with `ledger-cli migrate`.
      - name: Build ledger-cli for the test databases
        run: cargo build --locked -p ledger-cli --manifest-path rust-api/Cargo.toml

      - name: Run unit and integration tests with coverage
        run: npm run test:coverage

      # Coverage shows where no test runs, to help find a gap; it is not a
      # gate and has no percentage to reach. The summary lists the files with
      # the most lines that no test ran. The HTML report is the artifact.
      - name: Write the coverage summary
        run: node scripts/coverage-summary.mjs >> "$GITHUB_STEP_SUMMARY"

      - name: Keep the coverage report
        uses: actions/upload-artifact@v7
        with:
          name: coverage-report
          path: coverage/
          retention-days: 14
