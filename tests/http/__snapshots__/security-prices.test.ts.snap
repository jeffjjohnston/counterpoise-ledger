exports[`security price HTTP parity > stores a source that is not a string as Node does 1`] = `
{
  """": {
    "source": "",
    "status": 200,
  },
  "1.5": {
    "source": "1.5",
    "status": 200,
  },
  "5": {
    "source": "5",
    "status": 200,
  },
