# Copy to .env.local for development, or .env.production.local for the Docker
# deployment's own checkout on the main branch.
# Dev database: docker compose -f docker-compose.dev.yml up -d --wait.
# Production Postgres has no host port; dev alone publishes localhost:5432.
#
# RULE: secrets in .env.local must NOT match .env.production.local.
# Dev values get pasted into docs, issue reports, and terminals far more
# casually than production ones. Keeping them distinct means such a paste
# discloses nothing that protects production.

# Local development connects to counterpoise_dev as the bootstrap role. That
# credential is published, and deliberately so — these databases are disposable
# and four dev and test entry points hardcode it.
DATABASE_URL=postgresql://counterpoise:counterpoise@localhost:5432/counterpoise_dev

# For .env.production.local, two things change. Use the compose service
# hostname, because inside a container localhost is the container itself.
# And use the application role from APP_DB_PASSWORD below, NOT the published
# bootstrap credential — the app refuses to start on that one.
#
#   DATABASE_URL=postgresql://counterpoise_app:PASTE_APP_DB_PASSWORD@postgres:5432/counterpoise
#
# Write the password out in full here rather than referring to the variable
# above. env_file DOES interpolate an unquoted or double-quoted value, so a
# ${APP_DB_PASSWORD} here may expand — or, under single quotes or `format:
# raw`, arrive literally. Spelling the password out avoids depending on which.

# Bearer token for /api/cron/* endpoints. Read via env_file by both the rust-api
# and scheduler services, which must therefore hold the same value as each other.
# Generate with: openssl rand -hex 32
# Use a DIFFERENT value in dev than in production.
CRON_SECRET=

# Plaid bank sync. See "Connecting a Bank (Plaid)" in the README for how to get
# these, and `npm run plaid:link` for minting an access token.
# Dev must use SANDBOX credentials — production credentials in .env.local mean
# `npm run dev` reaches real banks and bills real API requests, and the separate
# counterpoise_dev database does nothing to prevent it (it bounds writes, not
# outbound calls).
# Leaving client id/secret blank makes isPlaidConfigured() false, so sync fails
# closed rather than reaching a live institution.
# PLAID_ENV takes sandbox or production only; Plaid retired the development
# environment, so that value now resolves to a host that no longer answers.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Optional TypeSafe experiment. Both server configuration AND a book's Settings
# opt-in are required. Restart the app after changing this installation-wide switch.
# Keep the key server-side; use a separate key for development. Never NEXT_PUBLIC_.
TYPESAFE_ENABLED=false
TYPESAFE_API_KEY=

# Tiingo end-of-day security prices. Read-only market data with no sandbox tier,
# so sharing one key across dev and prod is acceptable; the only cost is dev
# consuming the production rate limit.
TIINGO_API_KEY=

# PostHog telemetry — configure in .env.production.local only.
# Omit from .env / .env.local so dev and test never send events.
# The two NEXT_PUBLIC_ values go into the client at BUILD TIME (vite.config.ts
# reads them; docker-compose.yml passes them as build args of rust-api), so a
# change needs a rebuild — ./scripts/deploy.sh rebuilds. The Rust server also
# reads them at runtime for server-side events.
# NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_api_key
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# POSTHOG_PERSONAL_API_KEY=phx_your_personal_api_key

# Timezone for the postgres, rust-api, migrate and scheduler containers. SET
# THIS to your own zone — it controls cron firing times and, via CURRENT_DATE, the effective date
# of floating transactions. Leaving it unset falls back to America/New_York.
#
# This and POSTGRES_PASSWORD below are read by Compose *interpolation*, which
# only sees the shell, a .env file, or --env-file. Run compose as
# `docker compose --env-file .env.production.local up -d` or these are ignored.
TZ=America/New_York

# Bootstrap superuser password, read by production Compose on first init.
# REQUIRED for a deployment: production Compose has no fallback, and the
# postgres image refuses to initialize a fresh volume without one. Generate
# with:
#   openssl rand -hex 32
#
# The separate dev Compose file uses its own published disposable credential,
# which is why this one must not be that value.
# POSTGRES_PASSWORD=

# Set nowhere by default, and not needed here at all. The dev database
# container schedules its own test-database sweep and carries this connection
# in docker-compose.dev.yml; production runs no test-database cleanup. This
# line is only for running the sweep BY HAND from the host against the dev
# instance -- localhost:5432 is dev, the one instance publishing a host port:
# SWEEP_DATABASE_URL=postgresql://counterpoise:counterpoise@localhost:5432/postgres

# Password for the application role (counterpoise_app), which owns the
# production database and is NOT a superuser. Generate with:
#   openssl rand -hex 32
#
# Read on the FIRST initialization of the postgres volume, by
# scripts/postgres-init/01-app-role.sh. Setting it later has no effect — the
# postgres image skips that directory once the volume holds a database. An
# instance already running is migrated by hand; see "Separating the application
# database role" in the top-level README.
#
# Also paste it into DATABASE_URL above. Nothing derives one from the other.
APP_DB_PASSWORD=

# Where the rust-api container publishes host port 3000. Defaults to loopback
# so that a reverse proxy is the only ingress; set 0.0.0.0 to expose it on your LAN.
# Read by Compose interpolation, so pass --env-file (see README).
# Compose also gives this value to the server, which uses it to choose the
# client address for the rate limits (see TRUST_PROXY below).
APP_BIND=127.0.0.1

# Whether the rate limits take the client address from X-Forwarded-For.
# Unset: yes when APP_BIND is loopback (then a reverse proxy on this host is
# the only way in), no in all other cases. With no, the server uses the TCP
# peer address and ignores the header, because a client that connects directly
# can write any value in it.
#   true  — every request comes through a proxy that sets or appends
#           X-Forwarded-For, but the port is not on loopback (for example,
#           a proxy on a different host)
#   false — never use the header
# Any other value stops the server at start. See README, "Client addresses
# and rate limits".
# TRUST_PROXY=true

# Registration control. Unset means open only while no user exists, so a fresh
# install can create its first account and then closes itself.
#   true  — always open (set this temporarily to add a household member)
#   false — always closed
# REGISTRATION_ENABLED=true

# Send Strict-Transport-Security. Set this ONLY once HTTPS is confirmed
# working: it tells browsers to refuse plain HTTP to this host for a year,
# which will lock you out of a LAN deployment served over HTTP.
#
# The Rust server reads this value when it starts. It is not a build
# argument. After a change, recreate the container (docker compose up -d
# --force-recreate rust-api); a plain restart does not read the file again.
# ENABLE_HSTS=true
